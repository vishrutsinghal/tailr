{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/release-manifest.schema.json",
  "title": "TailTrail release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "candidate_additions", "candidate_exclusions", "required_release_files", "workflows", "public_audit", "repository_hygiene", "distribution", "smoke"],
  "properties": {
    "schema_version": {"const": "1"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "version_sources"],
      "properties": {
        "name": {"const": "tailtrail"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "version_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "candidate_additions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "prefixes"],
      "properties": {
        "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "required_release_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required_fragments"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required_fragments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "public_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_suffixes", "allowed_repository_urls", "excluded_files"],
      "properties": {
        "text_suffixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "allowed_repository_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://github\\.com/"}},
        "excluded_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "repository_hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_names", "forbidden_parts", "allowed_paths"],
      "properties": {
        "forbidden_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_parts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_only_files", "admin_only_files", "internal_excluded_files", "internal_excluded_prefixes"],
      "properties": {
        "public_only_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "admin_only_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "internal_excluded_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "internal_excluded_prefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_commands", "journey_commands"],
      "properties": {
        "preflight_commands": {"$ref": "#/$defs/commands"},
        "journey_commands": {"$ref": "#/$defs/commands"}
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
  }
}
