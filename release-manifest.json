  "workflows": [
    {
      "path": ".github/workflows/trust.yml",
      "required_fragments": [
        "python -m unittest discover -s tests",
        "python scripts/enterprise-readiness.py validate",
        "python scripts/check-tailtrail.py",
        "python scripts/public-doc-audit.py",
        "python scripts/release-check.py",
        "python scripts/smoke-test.py"
      ]
    },
    {
      "path": ".github/workflows/spec-kit-closure.yml",
      "required_fragments": [
        "python3 scripts/tailtrail.py spec-kit ci-gate"
      ]
    },
    {
      "path": ".github/workflows/platform-supply-chain.yml",
      "required_fragments": [
        "os: [ubuntu-latest, macos-latest, windows-latest]",
        "python-version: [\"3.12\", \"3.13\"]",
        "python scripts/platform-qualification.py report",
        "python scripts/supply-chain.py verify",
        "actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6"
      ]
    },
    {
      "path": ".github/workflows/repository-enforcement.yml",
      "required_fragments": [
        "permissions:",
        "contents: read",
        "python scripts/tailtrail.py enforce validate",
        "uses: ./.github/actions/enforce",
        "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"
      ]
    }
