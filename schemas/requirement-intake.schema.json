{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/requirement-intake.schema.json",
  "title": "TailTrail Pre-Lock Requirement Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "type", "intake_id", "revision", "state",
    "created_at", "updated_at", "identity", "requested_mode",
    "requirements", "questions", "answers", "requirement_sufficiency", "requirement_evidence",
    "continuation", "authority", "boundary"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "type": { "const": "tailtrail-requirement-intake" },
    "intake_id": { "type": "string", "pattern": "^intake-[a-f0-9]{16}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["awaiting-requirements", "answered"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "goal", "route", "host"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "route": { "enum": ["lite-questions", "aidlc-standard", "aidlc-full"] },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "requested_mode": { "type": ["string", "null"] },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "decision_class", "question", "impact", "evidence_refs"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "decision_class": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "impact": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "answers": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "requirement_sufficiency": {
      "type": "object",
      "required": ["schema_version", "type", "state", "material_decisions", "recommended_route", "boundary"],
      "properties": {
        "schema_version": { "const": "1" },
        "type": { "const": "tailtrail-requirement-sufficiency" },
        "state": { "enum": ["clarification-required", "standard-recommended", "full-recommended"] },
        "material_decisions": { "type": "array", "minItems": 1, "maxItems": 3 },
        "recommended_route": { "enum": ["lite-questions", "aidlc-standard", "aidlc-full"] },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "requirement_evidence": {
      "type": "object",
      "required": ["schema_version", "type", "root_fingerprint", "goal_fingerprint", "limits", "metrics", "decisions", "boundary", "fingerprint"],
      "properties": {
        "schema_version": { "const": "1" },
        "type": { "const": "tailtrail-requirement-evidence" },
        "root_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "goal_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "limits": { "type": "object" },
        "metrics": { "type": "object" },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 3 },
        "boundary": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "requirement_interpretation": {
      "type": "object",
      "required": ["schema_version", "type", "state", "requirements", "sufficiency"]
    },
    "route_posture": { "type": ["object", "null"] },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "intake_id", "prompt", "boundary"],
      "properties": {
        "action": { "enum": ["requirements-answer", "requirements-resume"] },
        "intake_id": { "type": "string", "pattern": "^intake-[a-f0-9]{16}$" },
        "prompt": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_lock", "scope", "implementation"],
      "properties": {
        "planning_lock": { "const": false },
        "scope": { "const": false },
        "implementation": { "const": false }
      }
    },
    "boundary": { "type": "string", "minLength": 1 }
  }
}
