{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/input-role-registry.schema.json",
  "title": "TailTrail Input Role Registry",
  "type": "object",
  "required": ["schema_version", "type", "target_root", "inputs", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-input-role-registry"},
    "target_root": {"type": "string"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input_id", "role", "locator", "access", "status"],
        "properties": {
          "input_id": {"type": "string"},
          "role": {"enum": ["target", "related-repo", "reference-repo", "design-reference", "requirement-artifact", "evidence-artifact"]},
          "locator": {"type": "string"},
          "access": {"enum": ["read-write-after-approval", "read-only"]},
          "status": {"enum": ["verified", "available-unread", "unavailable", "declared-unread"]}
        },
        "additionalProperties": true
      }
    },
    "boundary": {"type": "string"}
  },
  "additionalProperties": true
}
