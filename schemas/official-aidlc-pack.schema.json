{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail pinned official AIDLC pack manifest",
  "type": "object",
  "required": ["schema_version", "type", "official", "host_adapter", "integrity"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-official-aidlc-pack"},
    "official": {
      "type": "object",
      "required": ["source", "revision", "license"],
      "properties": {
        "source": {"const": "https://github.com/awslabs/aidlc-workflows"},
        "revision": {"type": "string", "minLength": 1},
        "license": {
          "type": "object",
          "required": ["spdx", "file"],
          "properties": {"spdx": {"const": "MIT-0"}, "file": {"type": "string", "minLength": 1}}
        }
      }
    },
    "host_adapter": {
      "type": "object",
      "required": ["host", "rules_path"],
      "properties": {"host": {"enum": ["codex", "copilot", "claude", "generic"]}, "rules_path": {"type": "string", "minLength": 1}}
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        }
      }
    }
  }
}
