{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail official AIDLC pack manifest",
  "oneOf": [
    {"$ref": "#/$defs/legacy_project_pack_v1"},
    {"$ref": "#/$defs/bundled_pack_v2"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "integrity_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/integrity_file"}
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "file"],
      "properties": {
        "spdx": {"const": "MIT-0"},
        "file": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "legacy_project_pack_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "official", "host_adapter", "integrity"],
      "properties": {
        "schema_version": {"const": "1"},
        "type": {"const": "tailtrail-official-aidlc-pack"},
        "official": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "revision", "license"],
          "properties": {
            "source": {"const": "https://github.com/awslabs/aidlc-workflows"},
            "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{7,64}|v[0-9][0-9A-Za-z._-]*)$"},
            "commit": {"type": "string", "pattern": "^(?:|[0-9a-f]{7,64})$"},
            "license": {"$ref": "#/$defs/license"}
          }
        },
        "host_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "rules_path"],
          "properties": {
            "host": {"enum": ["codex", "copilot", "claude", "generic"]},
            "rules_path": {"$ref": "#/$defs/safe_relative_path"}
          }
        },
        "integrity": {"$ref": "#/$defs/integrity"}
      }
    },
    "bundled_pack_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "bundle", "official", "compatibility", "required_capabilities", "integrity"],
      "properties": {
        "schema_version": {"const": "2"},
        "type": {"const": "tailtrail-bundled-official-aidlc-pack"},
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format_version", "tailtrail_version", "bundle_version", "created_from"],
          "properties": {
            "format_version": {"const": "1"},
            "tailtrail_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "bundle_version": {"type": "string", "minLength": 1},
            "created_from": {"const": "verified-upstream-release"}
          }
        },
        "official": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "revision", "commit", "source_archive_sha256", "license"],
          "properties": {
            "source": {"const": "https://github.com/awslabs/aidlc-workflows"},
            "revision": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_archive_sha256": {"$ref": "#/$defs/sha256"},
            "license": {
              "allOf": [
                {"$ref": "#/$defs/license"},
                {"required": ["sha256"]}
              ]
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_tailtrail_version", "maximum_tailtrail_version_exclusive", "manifest_schema", "supported_hosts"],
          "properties": {
            "minimum_tailtrail_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "maximum_tailtrail_version_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
            "manifest_schema": {"const": "2"},
            "supported_hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["codex", "copilot", "claude"]}
            }
          }
        },
        "required_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirements"],
          "properties": {
            "requirements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/safe_relative_path"}
            }
          }
        },
        "integrity": {"$ref": "#/$defs/integrity"}
      }
    }
  }
}
