{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/task-recovery-boundary.schema.json",
  "title": "TailTrail Mode A Task Recovery Boundary",
  "type": "object",
  "required": ["schema_version", "type", "mode", "run_id", "task_branch", "base_commit", "expected_paths", "active_requirement_uid", "requirements", "recovery_attempts"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-task-recovery-boundary"}, "mode": {"const": "mode-a"},
    "run_id": {"type": "string"}, "task_branch": {"type": "string", "pattern": "^tailtrail/"}, "base_commit": {"type": "string"},
    "expected_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "active_requirement_uid": {"type": ["string", "null"]},
    "requirements": {"type": "object"}, "recovery_attempts": {"type": "array"}
  }, "additionalProperties": false
}
