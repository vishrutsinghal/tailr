{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-0 Context Receipt","type":"object",
  "required":["schema_version","type","workflow_id","stage_id","selected_refs","avoided_categories","exactness","token_posture","context_budget_tokens","reduction_status","retrieval_refs","receipt_fingerprint","boundary"],
  "properties":{"schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-context-receipt"},"workflow_id":{"type":"string","pattern":"^ttw-"},"stage_id":{"type":"string"},"selected_refs":{"type":"array","uniqueItems":true,"items":{"pattern":"^\\.tailtrail/"}},"avoided_categories":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"exactness":{"enum":["must-be-exact","structured-lossless","categorical-summary"]},"token_posture":{"const":"estimated"},"context_budget_tokens":{"type":"integer","minimum":0},"reduction_status":{"enum":["not-requested","reduced","unavailable","not-applicable"]},"retrieval_refs":{"type":"array","uniqueItems":true,"items":{"pattern":"^\\.tailtrail/"}},"receipt_fingerprint":{"pattern":"^sha256:"},"boundary":{"type":"string"}},"additionalProperties":false
}
