{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Debug Hypothesis Ledger",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "requirement_uid", "failure_fingerprint", "cycle_limit", "cycle", "experiments_since_reset", "investigation_blocked", "recovery_replan_ref", "hypotheses", "sequence"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-hypothesis-ledger"},
    "run_id": {"type": "string", "minLength": 1},
    "requirement_uid": {"type": ["string", "null"]},
    "failure_fingerprint": {"type": ["string", "null"]},
    "cycle_limit": {"type": "integer", "minimum": 1},
    "cycle": {"type": "integer", "minimum": 1},
    "experiments_since_reset": {"type": "integer", "minimum": 0},
    "investigation_blocked": {"type": "boolean"},
    "recovery_replan_ref": {"type": ["string", "null"]},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "domain", "statement", "rank", "status"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "domain": {"enum": ["code", "architecture", "database", "api-integration"]},
          "statement": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "advisory_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["direction", "label", "summary", "artifact_ref"],
              "properties": {
                "direction": {"enum": ["supports", "contradicts"]},
                "label": {"enum": ["local-source-observation", "orientation", "heuristic"]},
                "summary": {"type": "string", "minLength": 1},
                "artifact_ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "discriminating_signal": {"type": ["string", "null"]},
          "next_experiment": {"type": ["string", "null"]},
          "status": {"enum": ["open", "eliminated", "proven"]}
        },
        "additionalProperties": false
      }
    },
    "sequence": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
