{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/release-channel.schema.json",
  "title": "TailTrail trusted release channel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "repository", "latest_release", "current_source_version", "publication", "artifact", "verification", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-release-channel"},
    "repository": {"const": "https://github.com/vishrutsinghal/tailr"},
    "latest_release": {"const": "https://github.com/vishrutsinghal/tailr/releases/latest"},
    "current_source_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publication": {"const": "tag-gated"},
    "artifact": {"type": "string", "minLength": 1},
    "verification": {"type": "object", "additionalProperties": false, "required": ["identity", "checksum", "install"], "properties": {"identity": {"type": "string"}, "checksum": {"type": "string"}, "install": {"type": "string"}}},
    "boundary": {"type": "string", "minLength": 1}
  }
}
