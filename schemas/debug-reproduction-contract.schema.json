{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Debug Reproduction Contract",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "requirement_uid", "domain", "status", "trigger", "expected", "actual", "reproduction_method", "preserve_rules", "safety_boundary", "validation_contract", "unresolved_fields", "revision"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-reproduction-contract"},
    "run_id": {"type": "string", "minLength": 1},
    "requirement_uid": {"type": "string", "pattern": "^req-[a-f0-9]{12}$"},
    "domain": {"enum": ["code", "architecture", "database", "api-integration"]},
    "status": {"enum": ["awaiting-approval", "approved", "rejected"]},
    "trigger": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "reproduction_method": {"type": "string", "minLength": 1},
    "preserve_rules": {"type": "array", "items": {"type": "string"}},
    "safety_boundary": {"type": "string", "minLength": 1},
    "validation_contract": {
      "type": "object",
      "required": ["state", "tiers"],
      "properties": {
        "state": {"enum": ["required"]},
        "tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reproduction", "root-cause", "regression", "behaviour"]}},
        "expected_exit_code_before_fix": {"type": "integer"},
        "required_output": {"type": "array", "items": {"type": "string"}},
        "expected_exit_code_after_fix": {"type": "integer"},
        "required_output_after_fix": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unresolved_fields": {"type": "array", "uniqueItems": true, "items": {"enum": ["domain", "trigger", "expected", "actual", "reproduction_method", "preserve_rules", "safety_boundary"]}},
    "field_feedback": {"type": "object"},
    "revision": {"type": "integer", "minimum": 1},
    "approved_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
