{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Execution Evidence Event",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "sequence", "kind", "requirement_uids", "evidence_boundary"],
  "properties": {
    "schema_version": {"enum": ["1", "2"]},
    "type": {"const": "tailtrail-execution-evidence"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "fingerprint": {"type": "string"},
    "kind": {"enum": ["source-edit", "command-result", "harness-result", "drift-finding", "ci-receipt"]},
    "requirement_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "tier": {"type": "string"},
    "tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "command_label": {"type": "string"}, "command": {"type": "string"},
    "outcome": {"enum": ["pass", "fail", "blocked", "timed-out", "unavailable"]},
    "environment": {"type": "string"}, "asserted_behavior": {"type": "string"}, "artifact": {"type": "string"},
    "evidence_label": {"enum": ["local-command", "managed-command", "ci-receipt", "host-telemetry"]},
    "evidence_quality": {"enum": ["trusted", "attested", "declared"]}, "collector": {"type": "string"},
    "exit_code": {"type": "integer"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0}, "stdout_artifact": {"type": "string"}, "stderr_artifact": {"type": "string"},
    "stdout_sha256": {"type": "string"}, "stderr_sha256": {"type": "string"}, "classification": {"type": "string"},
    "evidence_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
