{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail Enterprise Restore Validation", "type": "object",
  "required": ["schema_version", "type", "backup_ref", "workflow_id", "status", "issues", "canonical_state_replaced", "boundary"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-enterprise-restore-validation"}, "backup_ref": {"type": "string"}, "workflow_id": {"type": "string"},
    "status": {"enum": ["passed", "blocked"]}, "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "canonical_state_replaced": {"const": false}, "boundary": {"type": "string", "minLength": 1, "maxLength": 500}
  }, "additionalProperties": false
}
