{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/coordinated-plan.schema.json",
  "title": "TailTrail Coordinated Plan Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "outcome", "children", "shared_proof", "success_criteria"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "outcome": {"type": "string", "minLength": 1},
    "children": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "owner", "requirements", "depends_on"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "shared_proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "tiers", "asserted_behavior"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "tiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "asserted_behavior": {"type": "string", "minLength": 1}
        }
      }
    },
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
