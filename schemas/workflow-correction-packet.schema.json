{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail Phase 6 Correction Packet", "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "stage_id", "requirement_uids", "failure_fingerprint", "cycle", "max_cycles", "classification", "status", "retry", "preserved_passed_stage_ids", "preservation_refs", "reconciliation", "next_action", "boundary"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-correction-packet"}, "workflow_id": {"type": "string", "pattern": "^ttw-"}, "tailtrail_run_id": {"type": "string", "minLength": 1}, "stage_id": {"type": "string"}, "requirement_uids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "failure_fingerprint": {"type": "string", "pattern": "^sha256:"}, "cycle": {"type": "integer", "minimum": 1}, "max_cycles": {"type": "integer", "minimum": 1}, "classification": {"enum": ["actionable", "improved", "unchanged", "ambiguous", "regressed", "new-drift", "needs-decision", "scope-conflict", "same-hunk-overlap"]}, "status": {"enum": ["correction-ready", "recovery-replan", "needs-decision"]},
    "retry": {"type": "object", "additionalProperties": true}, "preserved_passed_stage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "preservation_refs": {"type": "array", "items": {"type": "object", "required": ["ref", "hash"], "properties": {"ref": {"type": "string"}, "hash": {"type": "string", "pattern": "^sha256:"}}, "additionalProperties": false}},
    "reconciliation": {"type": "object", "required": ["classification", "decision", "safe_to_apply"], "properties": {"classification": {"type": "string"}, "decision": {"type": ["string", "null"]}, "safe_to_apply": {"type": "boolean"}}, "additionalProperties": false}, "next_action": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1}
  }, "additionalProperties": false
}
