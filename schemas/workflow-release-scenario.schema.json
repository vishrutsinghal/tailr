{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Phase 11 Deterministic Scenario Receipt",
  "type": "object",
  "required": ["schema_version", "type", "scenario_id", "workflow_id", "tailtrail_run_id", "template_id", "outcome", "observations", "evidence_refs", "evidence_hashes", "receipt_fingerprint", "boundary"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-release-scenario"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "workflow_id": {"type": "string", "pattern": "^ttw-"},
    "tailtrail_run_id": {"type": "string", "minLength": 1}, "template_id": {"enum": ["small-change", "delivery", "risk-sensitive", "review-only", "ci-scanner-remediation", "repository-discovery"]},
    "outcome": {"const": "passed"}, "observations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:"}},
    "receipt_fingerprint": {"type": "string", "pattern": "^sha256:"}, "boundary": {"type": "string", "minLength": 1, "maxLength": 500}
  }, "additionalProperties": false
}
