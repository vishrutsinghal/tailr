{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Phase 11 Sanitized Real Local Run Proof",
  "type": "object",
  "required": ["schema_version", "type", "proof_id", "workflow_id", "tailtrail_run_id", "template_id", "target_identity_fingerprint", "compiler_plan_fingerprint", "completion_receipt_ref", "completion_receipt_hash", "host_receipt_refs", "host_receipt_hashes", "requirements", "metrics", "status", "proof_fingerprint", "boundary"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-real-run-proof"}, "proof_id": {"type": "string", "pattern": "^wfrp-[a-z0-9-]+$"},
    "workflow_id": {"type": "string", "pattern": "^ttw-"}, "tailtrail_run_id": {"type": "string", "minLength": 1},
    "template_id": {"enum": ["small-change", "delivery", "risk-sensitive", "review-only", "ci-scanner-remediation", "repository-discovery", "debug-investigation"]},
    "target_identity_fingerprint": {"type": "string", "pattern": "^sha256:"}, "compiler_plan_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "completion_receipt_ref": {"type": "string"}, "completion_receipt_hash": {"type": "string", "pattern": "^sha256:"}, "host_receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "host_receipt_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:"}},
    "requirements": {"type": "object", "required": ["complete", "preserved", "unresolved_drift"], "properties": {"complete": {"const": true}, "preserved": {"const": true}, "unresolved_drift": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "metrics": {"type": "object", "required": ["approval_prompts", "false_approvals", "stale_recomputations", "resume_checks", "resume_accurate", "duplicate_executions", "false_interventions", "correction_cycles", "recovery_safe", "review_effort", "estimated_token_receipts", "measured_token_receipts"], "properties": {
      "approval_prompts": {"type": "integer", "minimum": 0}, "false_approvals": {"type": "integer", "minimum": 0}, "stale_recomputations": {"type": "integer", "minimum": 0}, "resume_checks": {"type": "integer", "minimum": 0}, "resume_accurate": {"type": "boolean"}, "duplicate_executions": {"type": "integer", "minimum": 0}, "false_interventions": {"type": "integer", "minimum": 0}, "correction_cycles": {"type": "integer", "minimum": 0}, "recovery_safe": {"type": "boolean"}, "review_effort": {"enum": ["low", "moderate", "high", "not-measured"]}, "estimated_token_receipts": {"type": "integer", "minimum": 0}, "measured_token_receipts": {"type": "integer", "minimum": 0}
    }, "additionalProperties": false},
    "status": {"const": "accepted"}, "proof_fingerprint": {"type": "string", "pattern": "^sha256:"}, "boundary": {"type": "string", "minLength": 1, "maxLength": 500}
  }, "additionalProperties": false
}
