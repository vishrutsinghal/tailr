{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail DWR-minus Workflow Storage Event", "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "sequence", "event_id", "event_type", "previous_event_hash", "payload", "event_hash"],
  "properties": {"schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-storage-event"}, "workflow_id": {"pattern": "^ttw-[a-z0-9][a-z0-9-]{3,80}$"}, "tailtrail_run_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1}, "event_id": {"pattern": "^wfe-"}, "event_type": {"enum": ["workflow-initialized", "artifact-snapshot-captured", "workflow-created", "workflow-awaiting-approval", "workflow-ready", "workflow-started", "workflow-paused", "workflow-resumed", "workflow-blocked", "workflow-failed", "workflow-cancelled", "workflow-superseded", "workflow-completed", "workflow-follow-up-linked", "workflow-successor-linked", "stage-registered", "stage-ready", "stage-awaiting-approval", "stage-started", "stage-passed", "stage-failed", "stage-blocked", "stage-skipped", "stage-stale", "stage-cancelled"]}, "previous_event_hash": {"type": ["string", "null"]}, "payload": {"type": "object"}, "event_hash": {"pattern": "^sha256:"}}, "additionalProperties": false
}
