{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/maintainability-harness.schema.json",
  "title": "TailTrail Maintainability Harness",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "changed_paths", "findings", "advisories", "complete", "evidence_label", "boundary"],
  "properties": {
    "schema_version": {"enum": ["1", "2"]},
    "type": {"const": "tailtrail-maintainability-harness"},
    "run_id": {"type": "string"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "baseline": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "rule_results": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "advisories": {"type": "array", "items": {"type": "object"}},
    "complete": {"type": "boolean"},
    "evidence_label": {"type": "string"},
    "boundary": {"type": "string"}
  },
  "additionalProperties": true
}
