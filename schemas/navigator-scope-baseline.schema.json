{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/navigator-scope-baseline.schema.json",
  "title": "TailTrail Navigator Scope NS-0 Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "baseline_version",
    "program_phase",
    "program_extensions",
    "captured_at",
    "captured_revision",
    "ownership",
    "fixtures",
    "calibration",
    "boundaries",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "type": {
      "const": "tailtrail-navigator-scope-baseline"
    },
    "baseline_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "program_phase": {
      "const": "NS-0"
    },
    "program_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["FSR-0"]
      }
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "captured_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_decision",
        "target_identity",
        "relationship_evidence",
        "validated_persistence"
      ],
      "properties": {
        "scope_decision": {
          "const": "Navigator"
        },
        "target_identity": {
          "const": "Target Workspace"
        },
        "relationship_evidence": {
          "const": "Code Graph"
        },
        "validated_persistence": {
          "const": "Planning Lock"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fixture",
          "input_fingerprint",
          "state",
          "current_result",
          "current_result_fingerprint",
          "expected_result",
          "expected_result_fingerprint",
          "assertion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fixture": {
            "type": "string",
            "pattern": "^tests/fixtures/navigator-scope/[a-z0-9-]+\\.json$"
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "state": {
            "const": "known-gap"
          },
          "current_result": {
            "type": "object"
          },
          "current_result_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_result": {
            "type": "object"
          },
          "expected_result_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_false_stop_ids",
        "safe_stop_control_ids",
        "metrics",
        "release_posture"
      ],
      "properties": {
        "known_false_stop_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "safe_stop_control_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known_false_stop_count",
            "safe_stop_control_count",
            "observed_irrelevant_option_count",
            "unsafe_lock_count"
          ],
          "properties": {
            "known_false_stop_count": {"type": "integer", "minimum": 1},
            "safe_stop_control_count": {"type": "integer", "minimum": 1},
            "observed_irrelevant_option_count": {"type": "integer", "minimum": 1},
            "unsafe_lock_count": {"const": 0}
          }
        },
        "release_posture": {
          "const": "known-gap-not-release-proof"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior",
        "evidence",
        "privacy"
      ],
      "properties": {
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "sorted compact JSON excluding integrity"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
