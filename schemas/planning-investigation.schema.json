{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/planning-investigation.schema.json",
  "title": "TailTrail Bounded Planning Investigation Receipt",
  "type": "object",
  "required": ["schema_version", "type", "investigation_id", "run_id", "status", "paths_read", "source_facts", "graph_evidence", "commands_run", "source_changed", "tests_run", "created_at", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-plan-investigation"},
    "investigation_id": {"type": "string", "pattern": "^investigation-[0-9]{3,}$"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"const": "completed"},
    "paths_read": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_facts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "line_count", "symbols"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "line_count": {"type": "integer", "minimum": 0}, "symbols": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "graph_evidence": {"type": "object", "required": ["status", "reused", "reasons"], "properties": {"status": {"enum": ["fresh", "stale", "missing", "invalid", "not-applicable"]}, "reused": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "commands_run": {"const": []},
    "source_changed": {"const": false},
    "tests_run": {"const": false},
    "created_at": {"type": "string", "minLength": 1},
    "boundary": {"const": "Explicit approved read-only source inspection of already planned paths only; no source edit, test, scanner, build, package manager, Git, or plan mutation occurred."}
  },
  "additionalProperties": false
}
