{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-0 Workflow Instance","type":"object",
  "required":["schema_version","type","workflow_id","tailtrail_run_id","revision","template_id","status","stage_ids","planning_lock_ref","approved_anchor_ref","aidlc","boundary"],
  "properties":{"schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-instance"},"workflow_id":{"type":"string","pattern":"^ttw-[a-z0-9][a-z0-9-]{3,80}$"},"tailtrail_run_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"template_id":{"enum":["small-change","delivery","risk-sensitive","review-only","repository-discovery","ci-scanner-remediation","debug-investigation"]},"status":{"enum":["draft","awaiting_approval","ready","running","paused","blocked","failed","cancelled","superseded","completed"]},"stage_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"planning_lock_ref":{"type":"string","pattern":"^\\.tailtrail/"},"approved_anchor_ref":{"type":"string","pattern":"^\\.tailtrail/"},"aidlc":{"type":"object","required":["mode","artifact_refs"],"properties":{"mode":{"enum":["off","lite","standard","full"]},"artifact_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}}},"additionalProperties":false},"boundary":{"type":"string","minLength":1}},"additionalProperties":false
}
