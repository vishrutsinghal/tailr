{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Debug Experiment",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "sequence", "cycle", "hypothesis_id", "requirement_uid", "failure_fingerprint", "action", "expected_signal", "deterministic", "outcome", "evidence_event_id", "experiment_fingerprint", "evidence_boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-debug-experiment"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "cycle": {"type": "integer", "minimum": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "requirement_uid": {"type": "string", "minLength": 1},
    "failure_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "action": {"type": "string", "minLength": 1},
    "expected_signal": {"type": "string", "minLength": 1},
    "deterministic": {"const": true},
    "outcome": {"enum": ["eliminates", "strengthens", "unchanged", "regressed", "new-drift"]},
    "evidence_event_id": {"type": "string", "minLength": 1},
    "experiment_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "evidence_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
