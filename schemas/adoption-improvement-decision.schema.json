{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/adoption-improvement-decision.schema.json",
  "title": "TailTrail Adoption Improvement Proposal Or Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "proposal_id", "recommendation_id", "report_digest", "signal_id", "kind", "target", "action", "supporting_trial_ids", "participant_count", "created_at", "authority", "decision", "reason_code", "change_ref", "validation_ref", "boundary", "integrity"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-adoption-improvement-decision"},
    "proposal_id": {"type": "string", "pattern": "^adopt-proposal-[0-9a-f]{16}$"},
    "recommendation_id": {"type": "string", "pattern": "^adopt-rec-[0-9a-f]{16}$"},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"enum": ["wording", "default"]},
    "target": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "action": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "supporting_trial_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "participant_count": {"type": "integer", "minimum": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {"const": "human-approved-adoption-improvement-record"},
    "decision": {"enum": ["proposed", "applied", "rejected", "deferred"]},
    "reason_code": {"type": ["string", "null"]},
    "change_ref": {"type": ["string", "null"]},
    "validation_ref": {"type": ["string", "null"]},
    "boundary": {"type": "string", "minLength": 1},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "digest"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "sorted compact JSON excluding integrity"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
