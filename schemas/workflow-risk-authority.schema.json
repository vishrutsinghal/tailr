{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Deferred Phase 5 Risk Authority",
  "type": "object",
  "required": ["schema_version", "type", "authority_id", "risk_classes", "status", "policy_refs", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-workflow-risk-authority"},
    "authority_id": {"type": "string", "pattern": "^wfrisk-"},
    "risk_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dependency", "migration", "privacy", "auth", "secret", "infrastructure"]}},
    "status": {"enum": ["approved", "rejected"]},
    "policy_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
