{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail DWR-3 Approval Record",
  "type": "object",
  "required": ["schema_version", "type", "approval_id", "workflow_id", "tailtrail_run_id", "revision", "compiler_plan_fingerprint", "stage_graph_fingerprint", "target_identity_fingerprint", "approved_anchor_fingerprint", "stage_ids", "action_classes", "operation_kind", "bounded_operation_ref", "scope_ref", "scope_fingerprint", "requirement_uids", "decision", "source", "created_at", "expires_at", "session_id", "policy_ref", "policy_fingerprint", "rationale", "skip_reason_code", "reason_code", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-workflow-approval-record"},
    "approval_id": {"type": "string", "pattern": "^wfauth-[a-f0-9]{24}$"},
    "workflow_id": {"type": "string", "pattern": "^ttw-[a-z0-9][a-z0-9-]{3,80}$"},
    "tailtrail_run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "compiler_plan_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "stage_graph_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "target_identity_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "approved_anchor_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "stage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read_local", "write_tailtrail_state", "write_project", "execute_project", "scan_local", "external_provider", "publish"]}},
    "operation_kind": {"enum": ["initial-plan", "dependency", "broad-test-build", "scanner", "security-sensitive", "external-provider", "fix-application", "publish", "deploy", "merge", "other-guarded", "skip"]},
    "bounded_operation_ref": {"type": "string"},
    "scope_ref": {"type": "string"},
    "scope_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "requirement_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "decision": {"enum": ["approved", "rejected", "edited"]},
    "source": {"enum": ["interactive", "session", "policy"]},
    "created_at": {"type": "string"},
    "expires_at": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "policy_ref": {"type": ["string", "null"]},
    "policy_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "rationale": {"type": "string", "minLength": 1},
    "skip_reason_code": {"type": ["string", "null"]},
    "reason_code": {"enum": ["approval-granted", "approval-rejected"]},
    "authority_boundary": {"type": "string", "minLength": 1},
    "expired_at": {"type": "string"},
    "expiry_reason": {"enum": ["host-session-ended", "workflow-paused", "target-identity-changed", "material-plan-revision"]}
  },
  "additionalProperties": false
}
