{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-7 Evaluation Event","type":"object","required":["schema_version","type","workflow_id","tailtrail_run_id","template_id","stage_outcomes","stale_recomputation_count","correction_cycle_count","approval_count","requirement_completion","closure_state","event_fingerprint","boundary"],"properties":{"schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-evaluation-event"},"workflow_id":{"pattern":"^ttw-"},"tailtrail_run_id":{"type":"string"},"template_id":{"type":"string"},"stage_outcomes":{"type":"object","additionalProperties":{"enum":["pending","ready","awaiting_approval","running","passed","failed","blocked","skipped","stale","cancelled"]}},"stale_recomputation_count":{"type":"integer","minimum":0},"correction_cycle_count":{"type":"integer","minimum":0},"approval_count":{"type":"integer","minimum":0},"requirement_completion":{"enum":["complete","incomplete"]},"closure_state":{"enum":["completed","evidence-incomplete","evidence-incomplete-accepted"]},"event_fingerprint":{"pattern":"^sha256:"},"boundary":{"type":"string"}},"additionalProperties":false}
