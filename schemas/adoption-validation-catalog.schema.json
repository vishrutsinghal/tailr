{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/adoption-validation-catalog.schema.json",
  "title": "TailTrail Adoption Validation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "catalog_version", "evidence_label", "cohorts", "thresholds", "safety_boundaries", "feedback_signals", "decision_reason_codes", "claim_boundaries", "privacy", "integrity"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-adoption-validation-catalog"},
    "catalog_version": {"type": "string", "minLength": 1},
    "evidence_label": {"const": "evaluation-protocol"},
    "cohorts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "minimum_trials", "minimum_unique_participants", "minimum_scenarios", "time_to_plan_p75_ms_max", "approval_count_p75_max", "scenarios"],
        "properties": {
          "id": {"enum": ["new-user", "experienced-user"]},
          "minimum_trials": {"type": "integer", "minimum": 5},
          "minimum_unique_participants": {"type": "integer", "minimum": 5},
          "minimum_scenarios": {"type": "integer", "minimum": 2},
          "time_to_plan_p75_ms_max": {"type": "integer", "minimum": 1},
          "approval_count_p75_max": {"type": "integer", "minimum": 1},
          "scenarios": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
        }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_abandonment_rate_max", "redundant_approval_rate_max", "false_intervention_rate_max", "overall_completion_comprehension_rate_min", "cohort_completion_comprehension_rate_min", "safety_boundary_weakening_count_max", "recommendation_minimum_unique_participants"],
      "properties": {
        "overall_abandonment_rate_max": {"type": "number", "minimum": 0, "maximum": 1},
        "redundant_approval_rate_max": {"type": "number", "minimum": 0, "maximum": 1},
        "false_intervention_rate_max": {"type": "number", "minimum": 0, "maximum": 1},
        "overall_completion_comprehension_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
        "cohort_completion_comprehension_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
        "safety_boundary_weakening_count_max": {"const": 0},
        "recommendation_minimum_unique_participants": {"type": "integer", "minimum": 3}
      }
    },
    "safety_boundaries": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "feedback_signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feedback"}},
    "decision_reason_codes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "claim_boundaries": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "privacy": {"$ref": "#/$defs/privacy"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "feedback": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "target", "action"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "kind": {"enum": ["wording", "default"]}, "target": {"type": "string", "pattern": "^[a-z0-9.-]+$"}, "action": {"type": "string", "pattern": "^[a-z0-9-]+$"}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["sanitized", "raw_prompt", "raw_source", "raw_log", "identity_fields"], "properties": {"sanitized": {"const": true}, "raw_prompt": {"const": false}, "raw_source": {"const": false}, "raw_log": {"const": false}, "identity_fields": {"const": false}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "digest"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "sorted compact JSON excluding integrity"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
