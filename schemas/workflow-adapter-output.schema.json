{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Deferred Phase 4 Adapter Output",
  "type": "object",
  "required": ["schema_version", "type", "workflow_id", "stage_id", "adapter_id", "capability_id", "action_class", "authority", "idempotency_key", "requirement_uids", "outcome", "result", "evidence_refs", "recorded_at", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-workflow-adapter-output"},
    "workflow_id": {"type": "string", "pattern": "^ttw-"},
    "stage_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "action_class": {"enum": ["read_local", "write_tailtrail_state", "write_project", "execute_project", "scan_local", "external_provider", "publish"]},
    "authority": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^wfidem-"},
    "requirement_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "outcome": {"enum": ["pass", "fail", "blocked", "skipped", "timeout", "unavailable"]},
    "result": {"type": "object"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "recorded_at": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
