{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-3 Workflow Completion Receipt","type":"object","required":["schema_version","type","workflow_id","tailtrail_run_id","completion_report","completion_status","evidence_fingerprint","state","receipt_fingerprint","boundary"],"properties":{"schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-completion-receipt"},"workflow_id":{"pattern":"^ttw-[a-z0-9][a-z0-9-]{3,80}$"},"tailtrail_run_id":{"type":"string"},"completion_report":{"type":["string","null"]},"completion_status":{"enum":["complete","evidence-incomplete"]},"evidence_fingerprint":{"pattern":"^sha256:"},"state":{"enum":["completed","evidence-incomplete","evidence-incomplete-accepted"]},"receipt_fingerprint":{"pattern":"^sha256:"},"boundary":{"type":"string"}},"additionalProperties":false}
