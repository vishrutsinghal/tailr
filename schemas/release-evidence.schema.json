{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/release-evidence.schema.json",
  "title": "TailTrail Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "source", "build", "artifacts", "sbom", "provenance", "attestation", "valid"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-release-evidence"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["source_date_epoch", "dependencies"],
      "properties": {"source_date_epoch": {"type": "integer", "minimum": 0}, "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+==[^=]+$"}}}
    },
    "artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact"}},
    "sbom": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "attestation": {"enum": ["required-on-tag", "identity-attested"]},
    "valid": {"type": "boolean"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {"filename": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 1}}
    }
  }
}
