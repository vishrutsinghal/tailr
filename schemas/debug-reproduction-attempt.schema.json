{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Debug Reproduction Attempt",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "attempt", "phase_attempt", "phase", "outcome", "state", "reproduction_revision", "requirement_uid", "evidence_event_id", "command", "exit_outcome", "environment", "asserted_behavior", "observed_summary", "checked_dimensions", "input_request", "recorded_at", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-debug-reproduction-attempt"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "phase_attempt": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["pre-fix", "post-fix"]},
    "outcome": {"enum": ["reproduced", "not-reproduced", "inconclusive", "restored", "still-reproduced"]},
    "state": {"enum": ["reproduction-confirmed", "awaiting-reproduction-input", "behavior-restored", "correction-still-failing"]},
    "reproduction_revision": {"type": "integer", "minimum": 1},
    "requirement_uid": {"type": "string", "minLength": 1},
    "evidence_event_id": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "exit_outcome": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "asserted_behavior": {"type": "string", "minLength": 1},
    "observed_summary": {"type": "string", "minLength": 1},
    "checked_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["command-or-actions", "input-or-fixture", "runtime-version", "configuration", "environment", "permissions", "timing-or-frequency", "external-dependency", "unknown"]}},
    "input_request": {
      "type": ["object", "null"],
      "required": ["state", "summary", "requested", "response_prompt", "safety", "next_after_input"],
      "properties": {
        "state": {"const": "awaiting-reproduction-input"},
        "summary": {"type": "string", "minLength": 1},
        "requested": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "response_prompt": {"type": "string", "minLength": 1},
        "safety": {"type": "string", "minLength": 1},
        "next_after_input": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "recorded_at": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
