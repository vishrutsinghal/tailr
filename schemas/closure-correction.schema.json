{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/closure-correction.schema.json",
  "title": "TailTrail Closure Correction",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "status", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-closure-correction"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["no-correction-needed", "correction-ready", "replan-required"]},
    "failure_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_report": {"type": "string"},
    "active_requirement": {"type": "object"},
    "deferred_signals": {"type": "array"},
    "scope": {"type": "object"},
    "convergence": {"type": "object"},
    "continuity": {"type": "object"},
    "next_action": {"type": "string"},
    "boundary": {"type": "string"}
  },
  "additionalProperties": false
}
