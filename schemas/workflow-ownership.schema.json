{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Durable Workflow Ownership Binding",
  "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "planning_lock_ref", "approved_anchor_ref", "requirement_matrix_ref", "target_identity_fingerprint", "approved_anchor_fingerprint", "requirement_uids", "state", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-workflow-ownership-binding"},
    "workflow_id": {"pattern": "^ttw-[a-z0-9][a-z0-9-]{3,80}$"},
    "tailtrail_run_id": {"type": "string", "minLength": 1},
    "planning_lock_ref": {"type": "string", "pattern": "^\\.tailtrail/"},
    "approved_anchor_ref": {"type": "string", "pattern": "^\\.tailtrail/"},
    "requirement_matrix_ref": {"type": "string", "pattern": "^\\.tailtrail/"},
    "target_identity_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "approved_anchor_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "requirement_uids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "state": {"const": "bound"},
    "boundary": {"type": "string"}
  },
  "additionalProperties": false
}
