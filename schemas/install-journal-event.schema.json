{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/install-journal-event.schema.json",
  "title": "TailTrail installer journal event",
  "type": "object",
  "required": ["schema_version", "transaction_id", "operation", "state", "at"],
  "properties": {
    "schema_version": {"const": "1"},
    "transaction_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["install", "update", "repair", "uninstall"]},
    "state": {"enum": ["prepared", "complete", "recovered", "rolled-back"]},
    "at": {"type": "integer", "minimum": 0}
  }
}
