{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-0 Sanitized Runtime Event","type":"object",
  "required":["schema_version","type","event_id","workflow_id","sequence","event_type","stage_id","reason_code","artifact_refs","summary"],
