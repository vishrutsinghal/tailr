{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail Phase 6 Freshness Assessment", "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "checkpoint_revision", "checkpoint_fingerprint", "status", "change_types", "changes", "affected_stage_ids", "requirement_uids", "boundary"],
  "properties": {
    "schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-freshness-assessment"}, "workflow_id": {"type": "string", "pattern": "^ttw-"}, "tailtrail_run_id": {"type": "string", "minLength": 1},
    "checkpoint_revision": {"type": "integer", "minimum": 1}, "checkpoint_fingerprint": {"type": "string", "pattern": "^sha256:"}, "status": {"enum": ["fresh", "documentation-only", "stale"]},
    "change_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["source-edit", "manifest-change", "policy-change", "graph-stale", "doc-only-edit", "branch-change", "dependency-add", "security-finding", "reproduction-change"]}},
    "changes": {"type": "array", "items": {"type": "object", "required": ["change_type", "before_hash", "after_hash", "affected_stage_ids", "requirement_uids"], "properties": {"change_type": {"enum": ["source-edit", "manifest-change", "policy-change", "graph-stale", "doc-only-edit", "branch-change", "dependency-add", "security-finding", "reproduction-change"]}, "before_hash": {"type": "string", "pattern": "^sha256:"}, "after_hash": {"type": "string", "pattern": "^sha256:"}, "affected_stage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "requirement_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}},
    "affected_stage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "requirement_uids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "boundary": {"type": "string", "minLength": 1}
  }, "additionalProperties": false
}
