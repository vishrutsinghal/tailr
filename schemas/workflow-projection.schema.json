{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail DWR-minus Workflow Projection", "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "last_sequence", "last_event_hash", "artifact_refs", "artifact_hashes", "state", "lifecycle_state", "workflow_status", "stages", "current_stage_id", "parent_workflow_id", "successor_workflow_id", "workflow_reason_code", "terminal_reason_code", "boundary"],
  "properties": {"schema_version": {"const": "1"}, "type": {"const": "tailtrail-workflow-projection"}, "workflow_id": {"pattern": "^ttw-[a-z0-9][a-z0-9-]{3,80}$"}, "tailtrail_run_id": {"type": "string"}, "last_sequence": {"type": "integer", "minimum": 0}, "last_event_hash": {"type": ["string", "null"]}, "artifact_refs": {"type": "object"}, "artifact_hashes": {"type": "object"}, "state": {"enum": ["initialized", "captured"]}, "lifecycle_state": {"enum": ["initialized", "active", "paused", "failed", "cancelled", "superseded", "completed"]}, "workflow_status": {"enum": ["draft", "awaiting_approval", "ready", "running", "paused", "blocked", "failed", "cancelled", "superseded", "completed"]}, "stages": {"type": "object"}, "current_stage_id": {"type": ["string", "null"]}, "parent_workflow_id": {"type": ["string", "null"]}, "successor_workflow_id": {"type": ["string", "null"]}, "workflow_reason_code": {"type": ["string", "null"]}, "terminal_reason_code": {"type": ["string", "null"]}, "boundary": {"type": "string"}}, "additionalProperties": false
}
