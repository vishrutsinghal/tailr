{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/orchestrated-question-set.schema.json",
  "title": "TailTrail Orchestrated AIDLC Question Set",
  "type": "object",
  "required": ["questions", "quality", "traceability"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "recommended",
          "reasoning",
          "authority",
          "requirement_ids",
          "decision_class",
          "decision_impact",
          "known_context",
          "evidence_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "options": {"type": "array", "minItems": 3},
          "recommended": {"type": "string", "minLength": 1},
          "reasoning": {"type": "string", "minLength": 1},
          "authority": {"enum": ["local-lite", "official-ai-dlc-pack"]},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "decision_class": {"enum": ["user-decision", "policy-decision", "architecture-decision", "evidence-decision", "extension-opt-in"]},
          "decision_impact": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "known_context": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "quality": {"type": "object"},
    "traceability": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
