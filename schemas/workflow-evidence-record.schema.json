{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"TailTrail DWR-0 Evidence Record","type":"object",
  "required":["schema_version","type","evidence_id","workflow_id","stage_id","requirement_uids","evidence_type","artifact_ref","artifact_hash","outcome","label"],
  "properties":{"schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-evidence-record"},"evidence_id":{"type":"string","pattern":"^wfev-"},"workflow_id":{"type":"string","pattern":"^ttw-"},"stage_id":{"type":"string"},"requirement_uids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"evidence_type":{"type":"string"},"artifact_ref":{"type":"string"},"artifact_hash":{"type":"string","pattern":"^sha256:"},"outcome":{"enum":["pass","fail","blocked","skipped","unavailable"]},"label":{"enum":["local-evidence","provider-backed","measured","estimated"]}},"additionalProperties":false
}
