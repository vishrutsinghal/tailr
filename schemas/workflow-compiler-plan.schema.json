{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TailTrail DWR-1.5 Workflow Compiler Plan",
  "type":"object",
  "required":["schema_version","type","workflow_id","tailtrail_run_id","ownership_ref","capability_plan_ref","capability_plan_fingerprint","target_identity_fingerprint","repository_identity_fingerprint","policy_fingerprint","template_id","selected_capability_ids","stages","plan_fingerprint","compiler_trace","approval_questions","state","boundary","revision"],
  "properties":{
    "schema_version":{"const":"1"},"type":{"const":"tailtrail-workflow-compiler-plan"},"workflow_id":{"pattern":"^ttw-[a-z0-9][a-z0-9-]{3,80}$"},"tailtrail_run_id":{"type":"string"},
    "ownership_ref":{"pattern":"^\\.tailtrail/"},"capability_plan_ref":{"pattern":"^\\.tailtrail/"},"capability_plan_fingerprint":{"pattern":"^sha256:"},"target_identity_fingerprint":{"pattern":"^sha256:"},"repository_identity_fingerprint":{"pattern":"^sha256:"},"policy_fingerprint":{"pattern":"^sha256:"},
    "template_id":{"enum":["small-change","delivery","risk-sensitive","review-only","ci-scanner-remediation","repository-discovery"]},"selected_capability_ids":{"type":"array","items":{"type":"string"}},
    "stages":{"type":"array","minItems":1,"items":{"type":"object","required":["stage_id","capability_id","prerequisites","evidence","approval_class","action_class","adapter_id","adapter_action_class","execution_authority"],"properties":{"stage_id":{"type":"string"},"capability_id":{"type":"string"},"prerequisites":{"type":"array","items":{"type":"string"}},"evidence":{"type":"array","items":{"type":"string"}},"control_kind":{"const":"approval-gate"},"approval_class":{"enum":["none","canonical-approval","stage-approval"]},"action_class":{"enum":["read-only","tailtrail-state"]},"adapter_id":{"type":"string","minLength":1},"adapter_action_class":{"enum":["read_local","write_tailtrail_state","write_project","execute_project","scan_local","external_provider","publish"]},"execution_authority":{"const":"typed-adapter-executor"}},"additionalProperties":false}},
    "plan_fingerprint":{"pattern":"^sha256:"},"compiler_trace":{"type":"array","minItems":12,"maxItems":12,"items":{"type":"string"}},"approval_questions":{"type":"array","minItems":1,"items":{"type":"string"}},"state":{"const":"compiled"},"revision":{"type":"integer","minimum":1},"boundary":{"type":"string"}
  },
  "additionalProperties":false
}
