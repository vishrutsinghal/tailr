{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailTrail Deferred Phase 5 Template Execution Receipt",
  "type": "object",
  "required": ["schema_version", "type", "workflow_id", "tailtrail_run_id", "template_id", "plan_fingerprint", "requirement_uids", "workflow_status", "stages", "next_stage_id", "terminal", "boundary"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-workflow-template-execution"},
    "workflow_id": {"type": "string", "pattern": "^ttw-"},
    "tailtrail_run_id": {"type": "string", "minLength": 1},
    "template_id": {"enum": ["small-change", "delivery", "risk-sensitive", "review-only", "ci-scanner-remediation", "repository-discovery"]},
    "plan_fingerprint": {"type": "string", "pattern": "^sha256:"},
    "requirement_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "workflow_status": {"enum": ["ready", "running", "paused", "blocked", "failed", "cancelled", "superseded", "completed"]},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["stage_id", "capability_id", "adapter_id", "status", "required_evidence", "input_ref", "output_ref", "approval_id"], "properties": {"stage_id": {"type": "string"}, "capability_id": {"type": "string"}, "adapter_id": {"type": "string"}, "status": {"enum": ["pending", "ready", "awaiting_approval", "running", "passed", "failed", "blocked", "skipped", "stale", "cancelled"]}, "required_evidence": {"type": "array", "items": {"type": "string"}}, "input_ref": {"type": ["string", "null"]}, "output_ref": {"type": ["string", "null"]}, "approval_id": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "next_stage_id": {"type": ["string", "null"]},
    "terminal": {"type": "boolean"},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
