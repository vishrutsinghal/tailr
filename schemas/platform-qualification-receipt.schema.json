{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/platform-qualification-receipt.schema.json",
  "title": "TailTrail Platform Qualification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "observed", "runner", "python", "source_commit", "artifacts", "checks", "valid"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-platform-qualification-receipt"},
    "observed": {"const": true},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "system", "release", "machine", "ci"],
      "properties": {
        "os": {"enum": ["linux", "macos", "windows"]},
        "system": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "ci": {"type": "boolean"}
      }
    },
    "python": {"type": "string", "pattern": "^3\\.(12|13)$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "sdist_to_wheel"],
      "properties": {
        "wheel": {"$ref": "#/$defs/artifact"},
        "sdist_to_wheel": {"$ref": "#/$defs/artifact"}
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["pass", "fail", "not-applicable"]}
    },
    "valid": {"type": "boolean"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
