{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/planning-revision.schema.json",
  "title": "TailTrail Proposed Plan Revision",
  "description": "Versioned, pre-implementation plan delta. The original Start report remains immutable and the proposal requires exact revision approval.",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "revision", "base_revision", "state", "changes", "delta_summary", "approval_required", "base_report_fingerprint", "revised_report_fingerprint", "requirement_continuity", "rationale", "boundary", "created_at", "proposed_report"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-plan-revision"},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 2},
    "base_revision": {"type": "integer", "minimum": 1},
    "state": {"const": "awaiting-approval"},
    "changes": {"type": "array", "minItems": 1},
    "delta_summary": {"type": "object"},
    "approval_required": {"const": true},
    "base_report_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "revised_report_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requirement_continuity": {"type": "array", "minItems": 1},
    "rationale": {"type": "array", "minItems": 1},
    "boundary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "proposed_report": {"type": "object"}
  },
  "additionalProperties": false
}
