{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "TailTrail Enterprise Parent Child Link", "type": "object",
  "required": ["schema_version", "type", "parent_workflow_id", "parent_run_id", "parent_repository_id", "child_workflow_id", "child_run_id", "child_repository_id", "tenant_id", "relationship", "authority", "link_fingerprint", "boundary"],
  "properties": {
