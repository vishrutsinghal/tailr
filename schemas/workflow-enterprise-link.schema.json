    "parent_workflow_id": {"type": "string"}, "parent_run_id": {"type": "string"}, "parent_repository_id": {"type": "string"},
    "child_workflow_id": {"type": "string"}, "child_run_id": {"type": "string"}, "child_repository_id": {"type": "string"},
    "tenant_id": {"type": "string"}, "relationship": {"enum": ["parent-child"]}, "authority": {"const": "read-only-reference"},
