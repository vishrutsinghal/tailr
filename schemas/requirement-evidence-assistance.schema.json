{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.dev/schemas/requirement-evidence-assistance.schema.json",
  "title": "TailTrail Requirement Evidence Assistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "type", "root_fingerprint", "goal_fingerprint", "limits",
    "metrics", "decisions", "boundary", "fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "type": { "const": "tailtrail-requirement-evidence" },
    "root_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "goal_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_bytes", "max_file_bytes", "max_directories", "max_candidates", "execution_allowed"],
      "properties": {
        "max_files": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "max_file_bytes": { "type": "integer", "minimum": 1 },
        "max_directories": { "type": "integer", "minimum": 1 },
        "max_candidates": { "type": "integer", "minimum": 1 },
        "execution_allowed": { "const": false }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_read", "bytes_read", "findings", "stopped_by_limit", "directories_scanned"],
      "properties": {
        "files_read": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "stopped_by_limit": { "type": "integer", "minimum": 0 },
        "directories_scanned": { "type": "integer", "minimum": 0 }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id", "decision_class", "state", "findings",
          "recommendation", "resolution", "reason"
        ],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "decision_class": { "type": "string", "minLength": 1 },
          "state": { "enum": ["supported", "conflicting", "no-evidence", "limit-reached", "unsupported-decision-class"] },
          "findings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "kind", "option", "path", "line", "content_hash", "strength"],
              "properties": {
                "evidence_id": { "type": "string", "minLength": 1 },
                "kind": { "const": "repository-convention" },
                "option": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "strength": { "const": "supporting" }
              }
            }
          },
          "recommendation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["option", "confidence", "reason", "evidence_ids"],
                "properties": {
                  "option": { "type": "string", "minLength": 1 },
                  "confidence": { "const": "medium" },
                  "reason": { "type": "string", "minLength": 1 },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          },
          "resolution": { "const": "ask-user" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "boundary": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
