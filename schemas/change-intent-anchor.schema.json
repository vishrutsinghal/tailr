{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tailtrail.local/schemas/change-intent-anchor.schema.json",
  "title": "TailTrail Change Intent Anchor",
  "type": "object",
  "required": ["schema_version", "type", "run_id", "proposal_version", "requirements", "status"],
  "properties": {
    "schema_version": {"const": "1"},
    "type": {"const": "tailtrail-change-intent-anchor"},
    "run_id": {"type": "string", "minLength": 1},
    "proposal_version": {"type": "integer", "minimum": 1},
    "goal": {"type": "string"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "requirement-evidence.schema.json"}},
    "status": {"enum": ["draft", "approved"]},
    "fingerprint": {"type": "string"},
    "approved_fingerprint": {"type": "string"}
  }
}
