    {
      "expected_surface": "Start plan with bifurcated requirements, Lite/off mode decision, focused proof, token posture, and approval.",
      "id": "quick-small-fix",
      "level": "quick",
      "prompt": "Fix a focused validation defect and preserve the valid path.",
      "required_assertions": [
        "planning-lock",
        "requirements",
        "aidlc-mode",
        "selected-features",
        "validation",
        "tokens",
        "approval"
      ]
    },
    {
      "expected_surface": "Requirement-to-impact matrix, architecture and behavior posture, evidence tiers, and delivery slices.",
      "id": "guided-multi-file-feature",
      "level": "guided",
      "prompt": "Add a multi-file API and service behavior while preserving callers.",
      "required_assertions": [
        "impact-matrix",
        "architecture",
        "behaviour",
        "evidence-tiers",
        "delivery-slices"
      ]
    },
    {
      "expected_surface": "The complete canonical plan at Quick, Guided, and Expert layers with explicit unavailable/not-applicable reasons.",
      "id": "verbose-completeness",
      "level": "all",
      "prompt": "Run any Start request with --verbose.",
      "required_assertions": [
        "no-missing-sections",
        "requirements",
        "aidlc",
        "harnesses",
        "validation",
        "drift-recovery",
        "tokens",
        "approval"
      ]
    },
    {
      "expected_surface": "Pinned official authority, relevant questions/options/recommendations/reasons, then a canonical TailTrail plan after answers.",
      "id": "official-aidlc-standard",
      "level": "guided",
      "prompt": "Use AIDLC Standard for a cross-layer requirement.",
      "required_assertions": [
        "official-authority",
        "questions",
        "recommendations",
        "separate-approval"
      ]
    },
    {
      "expected_surface": "Same-run continuity, requirement-linked drift, bounded correction, and no premature closure.",
      "id": "hands-free-correction",
      "level": "guided",
      "prompt": "Run a hands-free feature where one requirement fails after the first implementation cycle.",
      "required_assertions": [
        "same-run",
        "drift",
        "continuity",
        "bounded-correction",
        "closure-blocked"
      ]
    },
    {
      "expected_surface": "Reproduction approval, orientation, falsifiable hypotheses, experiment evidence, proven root cause, and bounded correction.",
      "id": "debug-investigation",
      "level": "guided",
      "prompt": "Debug a duplicate side effect after an accepted timeout.",
      "required_assertions": [
        "reproduction",
        "orientation",
        "hypotheses",
        "experiment",
        "root-cause",
        "correction"
      ]
    },
    {
      "expected_surface": "Evidence-incomplete Completion Report and a requirement-linked correction path rather than success.",
      "id": "closure-evidence-gap",
      "level": "quick",
      "prompt": "Close a run with a missing required behavior receipt.",
      "required_assertions": [
        "evidence-incomplete",
        "requirement-status",
        "harness-status",
        "next-correction"
      ]
    },
    {
      "expected_surface": "Semantically identical canonical sections and authority across hosts.",
      "id": "host-conformance",
      "level": "expert",
